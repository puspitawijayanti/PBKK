<Window x:Class="StudentRegistrationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Registration"
        Height="720"
        Width="950"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="1.3*"/>
        </Grid.ColumnDefinitions>

        <!-- FORM -->
        <ScrollViewer Grid.Column="0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="STUDENT REGISTRATION"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <TextBlock Text="NIM"/>
                <TextBox x:Name="txtNim"
                         Height="35"
                         Margin="0,5,0,15"/>

                <TextBlock Text="Nama Mahasiswa"/>
                <TextBox x:Name="txtNama"
                         Height="35"
                         Margin="0,5,0,15"/>

                <TextBlock Text="Program Studi"/>
                <ComboBox x:Name="cmbProdi"
                          Height="35"
                          Margin="0,5,0,15">
                    <ComboBoxItem Content="Teknik Informatika"/>
                    <ComboBoxItem Content="Sistem Informasi"/>
                    <ComboBoxItem Content="Manajemen"/>
                    <ComboBoxItem Content="Akuntansi"/>
                </ComboBox>

                <TextBlock Text="Jenis Kelamin"/>
                <StackPanel Orientation="Horizontal"
                            Margin="0,5,0,15">
                    <RadioButton x:Name="rbLaki"
                                 Content="Laki-laki"
                                 Margin="0,0,20,0"/>
                    <RadioButton x:Name="rbPerempuan"
                                 Content="Perempuan"/>
                </StackPanel>

                <TextBlock Text="Tanggal Lahir"/>
                <DatePicker x:Name="dpTanggalLahir"
                            Height="35"
                            Margin="0,5,0,15"/>

                <TextBlock Text="Alamat"/>
                <TextBox x:Name="txtAlamat"
                         Height="60"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,5,0,15"/>

                <TextBlock Text="Nomor Telepon"/>
                <TextBox x:Name="txtTelepon"
                         Height="35"
                         Margin="0,5,0,20"/>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnSimpan"
                            Content="Simpan"
                            Width="120"
                            Height="40"
                            Margin="0,0,10,0"
                            Click="BtnSimpan_Click"/>
                    <Button Content="Reset"
                            Width="120"
                            Height="40"
                            Click="BtnReset_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- DATA -->
        <StackPanel Grid.Column="2">
            <TextBlock Text="DATA MAHASISWA"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Cari (NIM atau Nama)"/>
            <TextBox x:Name="txtCari"
                     Height="35"
                     Margin="0,5,0,15"
                     TextChanged="TxtCari_TextChanged"/>

            <ListBox x:Name="lstMahasiswa"
                     Height="330"/>

            <TextBlock x:Name="txtCounter"
                       Text="Jumlah Mahasiswa: 0"
                       FontWeight="Bold"
                       Margin="0,10,0,10"/>

            <StackPanel Orientation="Horizontal">
                <Button Content="Edit"
                        Width="120"
                        Height="40"
                        Margin="0,0,10,0"
                        Click="BtnEdit_Click"/>
                <Button Content="Hapus"
                        Width="120"
                        Height="40"
                        Click="BtnHapus_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>