<Window
    x:Class="StudentManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Student Management System"
    Width="1200"
    Height="750"
    MinWidth="1000"
    MinHeight="650"
    WindowStartupLocation="CenterScreen"
    Background="#F2F4F7">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="DangerButton">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border
            Grid.Row="0"
            Background="#1565C0"
            CornerRadius="10"
            Padding="20"
            Margin="0,0,0,15">
            <StackPanel>
                <TextBlock
                    Text="STUDENT MANAGEMENT SYSTEM"
                    Foreground="White"
                    FontSize="28"
                    FontWeight="Bold"/>
                <TextBlock
                    Text="Kelola data mahasiswa — Input, Statistik, Search, dan CRUD"
                    Foreground="White"
                    FontSize="14"
                    Opacity="0.85"/>
            </StackPanel>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- KOLOM KIRI: FORM + STATISTIK -->
            <StackPanel Grid.Column="0">

                <!-- FORM INPUT -->
                <Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="INPUT MAHASISWA" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" Foreground="#1565C0"/>

                        <TextBlock Text="NIM" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding SelectedStudent.NIM, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Nama" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding SelectedStudent.Nama, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Jurusan" Style="{StaticResource LabelStyle}"/>
                        <ComboBox SelectedValue="{Binding SelectedStudent.Jurusan, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Content">
                            <ComboBoxItem Content="Informatika"/>
                            <ComboBoxItem Content="Sistem Informasi"/>
                        </ComboBox>

                        <TextBlock Text="Gender" Style="{StaticResource LabelStyle}"/>
                        <ComboBox SelectedValue="{Binding SelectedStudent.Gender, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Content">
                            <ComboBoxItem Content="Laki-laki"/>
                            <ComboBoxItem Content="Perempuan"/>
                        </ComboBox>

                        <TextBlock Text="Email" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding SelectedStudent.Email, UpdateSourceTrigger=PropertyChanged}"/>

                        <UniformGrid Columns="2" Margin="0,8,0,0">
                            <Button Content="Simpan"
                                    Command="{Binding SaveCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,5,0"/>
                            <Button Content="Reset"
                                    Command="{Binding ResetCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="5,0,0,0"/>
                        </UniformGrid>

                        <Button Content="Hapus Data Terpilih"
                                Command="{Binding DeleteCommand}"
                                Style="{StaticResource DangerButton}"
                                Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- STATISTIK -->
                <Border Background="White" CornerRadius="10" Padding="18">
                    <StackPanel>
                        <TextBlock Text="INFORMASI" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" Foreground="#1565C0"/>

                        <Border Background="#EFF6FF" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Total Mahasiswa" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding TotalStudents}" FontSize="32" FontWeight="Bold" Foreground="#1565C0"/>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Background="#F8FAFC" CornerRadius="8" Padding="10" Margin="0,0,5,8">
                                <StackPanel>
                                    <TextBlock Text="Informatika" FontSize="12" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding TotalInformatika}" FontSize="24" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" Background="#F8FAFC" CornerRadius="8" Padding="10" Margin="5,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Sistem Informasi" FontSize="12" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding TotalSistemInformasi}" FontSize="24" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0" Background="#F8FAFC" CornerRadius="8" Padding="10" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="Laki-laki" FontSize="12" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding TotalLakiLaki}" FontSize="24" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Background="#F8FAFC" CornerRadius="8" Padding="10" Margin="5,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Perempuan" FontSize="12" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding TotalPerempuan}" FontSize="24" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- KOLOM KANAN: SEARCH + DATAGRID -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- SEARCH -->
                <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 Padding="10"
                                 Margin="0,0,10,0">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <Button Grid.Column="1"
                                Content="Cari"
                                Command="{Binding SearchCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,10,0"/>

                        <Button Grid.Column="2"
                                Content="Tampilkan Semua"
                                Command="{Binding ResetCommand}"
                                Style="{StaticResource SecondaryButton}"/>
                    </Grid>
                </Border>

                <!-- DATAGRID -->
                <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="15">
                    <DataGrid
                        ItemsSource="{Binding Students}"
                        SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        RowHeight="36"
                        AlternatingRowBackground="#F8FAFC"
                        BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NIM" Binding="{Binding NIM}" Width="100"/>
                            <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="180"/>
                            <DataGridTextColumn Header="Jurusan" Binding="{Binding Jurusan}" Width="150"/>
                            <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="100"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
